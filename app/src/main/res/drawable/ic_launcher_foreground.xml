<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground. 108dp canvas; launchers mask it to a circle/squircle and only the
  central 66dp (21..87) is guaranteed visible, so the mark stays inside 30..78.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Red "live" circle (r 24) with a thin outer ring -->
    <path
        android:fillColor="@color/livex_red"
        android:pathData="M30,54 A24,24 0 1 1 78,54 A24,24 0 1 1 30,54 Z" />
    <path
        android:strokeColor="@color/livex_red"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.5"
        android:pathData="M25.5,54 A28.5,28.5 0 1 1 82.5,54 A28.5,28.5 0 1 1 25.5,54 Z" />

    <!-- White play triangle (centroid at the canvas center) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:pathData="M49,44 L64,54 L49,64 Z" />
</vector>
